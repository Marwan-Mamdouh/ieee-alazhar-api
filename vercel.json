{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "express",
  "functions": {
    "src/server.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
